---
---

<div class="max-w-md mx-auto my-12 p-8 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-100 shadow-sm">
  <h2 class="text-2xl font-semibold tracking-tight text-center mb-1">Create Account</h2>
  <p class="text-sm text-zinc-400 text-center mb-6">Register to access DETECT eye tracking</p>

  <form id="register-form" class="space-y-4">
    <div>
      <label for="reg-username" class="block text-xs font-medium uppercase tracking-wider text-zinc-400 mb-1">
        Username
      </label>
      <input
        type="text"
        id="reg-username"
        name="username"
        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-500"
        placeholder="choose a username"
        required
      />
    </div>

    <div>
      <label for="reg-password" class="block text-xs font-medium uppercase tracking-wider text-zinc-400 mb-1">
        Password
      </label>
      <input
        type="password"
        id="reg-password"
        name="password"
        class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-500"
        placeholder="••••••••"
        required
      />
    </div>

    <div id="reg-auth-error" class="text-xs text-red-400 min-h-[16px]"></div>

    <button
      type="submit"
      class="w-full py-2 px-4 bg-zinc-100 hover:bg-white text-zinc-950 font-medium rounded text-sm transition-colors duration-150"
    >
      Register & Continue
    </button>

    <div class="text-center text-xs text-zinc-500 pt-2">
      Already registered?
      <a href="/login" class="text-zinc-300 underline hover:text-white font-medium ml-1">Sign In</a>
    </div>
  </form>
</div>

<script>
  import { actions, isInputError } from "astro:actions";

  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorEl = document.getElementById("reg-auth-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (errorEl) errorEl.textContent = "";

    const formData = new FormData(form);
    const { error, data } = await actions.register(formData);

    if (!isInputError(error)) {
      if (data?.success) {
        if (data.userID) {
          sessionStorage.setItem("userId", data.userID.toString());
        }
        window.location.href = "/live";
      } else {
        if (errorEl) errorEl.textContent = data?.message || "Registration failed.";
      }
    } else {
      if (errorEl) errorEl.textContent = "Please provide valid username and password.";
    }
  });
</script>
