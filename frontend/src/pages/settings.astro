---
import Main from "../layouts/Main.astro";
import SettingsComponents from "../components/SettingsComponents.svelte";
---

<Main>
  <div class="space-y-6">
    <div class="border-b border-zinc-800 pb-4">
      <h1 class="text-2xl font-bold text-zinc-100">DETECT Settings</h1>
      <p class="text-sm text-zinc-400 mt-1">Configure eye tracking sensitivity, normalization, and graph preferences.</p>
    </div>

    <SettingsComponents client:load />
  </div>
</Main>
