---
import Main from "../layouts/Main.astro";
import PupilTracker from "../components/PupilTracker.svelte";
---

<Main>
  <div class="space-y-6">
    <div class="border-b border-zinc-800 pb-4">
      <h1 class="text-3xl font-bold text-zinc-100">DETECT — Real-time Pupil Tracking & Graph</h1>
      <p class="text-sm text-zinc-400 mt-1">MediaPipe FaceMesh pupil tracking with live 60 FPS line graph plotting.</p>
    </div>

    <PupilTracker client:load />
  </div>
</Main>
