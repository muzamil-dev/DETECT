---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!DOCTYPE html>
<html lang="en" class="bg-zinc-950 text-zinc-100">
  <head>
    <title>DETECT — Real-time Eye Tracking</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DETECT - Real-time Eye Movement Tracking & Analytics powered by MediaPipe" />
    <script is:inline src="/mediapipe/camera_utils.js"></script>
    <script is:inline src="/mediapipe/drawing_utils.js"></script>
    <script is:inline src="/mediapipe/face_mesh.js"></script>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 py-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
